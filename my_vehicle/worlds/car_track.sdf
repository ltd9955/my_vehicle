<?xml version="1.0" ?>
<!--
  ==================================================================
  파일: car_track.sdf
  설명: Gazebo Sim(구 Ignition)을 위한 4주차 가상 주행 트랙 월드 파일입니다.
  특징:
    1. ODE 물리 엔진: 1ms 고정 타임스텝, 1000Hz 주파수, RTF 1.0 목표
    2. 필수 시스템 플러그인: Physics, UserCommands, SceneBroadcaster
    3. 무한 지면 평면 및 마찰계수(mu=1.0) 설정
    4. 트랙 외곽 안전벽 및 주행 가이드 장애물 배치
  ==================================================================
-->
<sdf version="1.8">
  <world name="car_track_world">

    <!-- ========================================== -->
    <!-- 1. 물리 엔진(Physics) 파라미터 설정         -->
    <!-- ========================================== -->
    <!--
      - max_step_size: 고정 타임스텝 (0.001초 = 1ms)
      - real_time_factor: 목표 실시간 배율 (1.0 = 현실 시간과 동일)
    -->
    <physics name="1ms" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- ========================================== -->
    <!-- 2. Gazebo 필수 시스템 플러그인 로드        -->
    <!-- ========================================== -->
    <!-- 물리 연산 시스템 -->
    <plugin
      filename="gz-sim-physics-system"
      name="gz::sim::systems::Physics">
    </plugin>

    <!-- 사용자 GUI 명령 및 모델 스폰 처리 시스템 -->
    <plugin
      filename="gz-sim-user-commands-system"
      name="gz::sim::systems::UserCommands">
    </plugin>

    <!-- 3D 렌더링 씬 정보를 GUI 및 센서로 브로드캐스팅하는 시스템 -->
    <plugin
      filename="gz-sim-scene-broadcaster-system"
      name="gz::sim::systems::SceneBroadcaster">
    </plugin>

    <!-- ========================================== -->
    <!-- 3. 환경 조명 (Directional Sun)             -->
    <!-- ========================================== -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 15 0 0 0</pose>
      <diffuse>0.85 0.85 0.85 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- ========================================== -->
    <!-- 4. 무한 지면 평면 (Ground Plane)           -->
    <!-- ========================================== -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode>
                <!-- 지면 마찰계수: 미끄러짐 방지를 위해 1.0으로 설정 -->
                <mu>1.0</mu>
                <mu2>1.0</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.7 0.7 0.7 1</ambient>
            <diffuse>0.7 0.7 0.7 1</diffuse>
            <specular>0.2 0.2 0.2 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- ========================================== -->
    <!-- 5. 트랙 외곽 안전벽 및 주행 가이드 장애물  -->
    <!-- ========================================== -->
    <!-- 북쪽 외곽벽 (길이 16m, 높이 0.5m) -->
    <model name="wall_north">
      <static>true</static>
      <pose>0 8 0.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box><size>16 0.3 0.5</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>16 0.3 0.5</size></box>
          </geometry>
          <material>
            <ambient>0.8 0.2 0.2 1</ambient>
            <diffuse>0.8 0.2 0.2 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- 남쪽 외곽벽 (길이 16m, 높이 0.5m) -->
    <model name="wall_south">
      <static>true</static>
      <pose>0 -8 0.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box><size>16 0.3 0.5</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>16 0.3 0.5</size></box>
          </geometry>
          <material>
            <ambient>0.8 0.2 0.2 1</ambient>
            <diffuse>0.8 0.2 0.2 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- 동쪽 외곽벽 (길이 16m, 높이 0.5m) -->
    <model name="wall_east">
      <static>true</static>
      <pose>8 0 0.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box><size>0.3 16 0.5</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>0.3 16 0.5</size></box>
          </geometry>
          <material>
            <ambient>0.8 0.2 0.2 1</ambient>
            <diffuse>0.8 0.2 0.2 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- 서쪽 외곽벽 (길이 16m, 높이 0.5m) -->
    <model name="wall_west">
      <static>true</static>
      <pose>-8 0 0.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box><size>0.3 16 0.5</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>0.3 16 0.5</size></box>
          </geometry>
          <material>
            <ambient>0.8 0.2 0.2 1</ambient>
            <diffuse>0.8 0.2 0.2 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- 중앙 코스 분리대 (아일랜드 장애물) -->
    <model name="center_divider">
      <static>true</static>
      <pose>0 0 0.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box><size>8 2.0 0.5</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>8 2.0 0.5</size></box>
          </geometry>
          <material>
            <ambient>0.2 0.6 0.3 1</ambient>
            <diffuse>0.2 0.6 0.3 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ========================================== -->
    <!-- 6. [도전 미션 4] 15도 경사로 (Ramp)         -->
    <!-- ========================================== -->
    <!--
      기본 실습(미션 1~3)이 끝난 뒤 아래 주석을 풀어서 사용하세요.
      - 차량 스폰 위치 (0, -4) 에서 +x 방향으로 3m 앞, 남쪽 차선 위에 배치
      - 길이 2m 판을 pitch = -15도(-0.2618 rad) 로 기울여 +x 로 갈수록 올라가는 경사로
      - 경사로 마찰(mu)과 URDF 바퀴 마찰(mu1/mu2)을 조절하며 등판 성공 여부를 비교
    -->
    <!--
    <model name="ramp_15deg">
      <static>true</static>
      <pose>4 -4 0.26 0 -0.2618 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box><size>2.0 1.5 0.05</size></box>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>1.0</mu>
                <mu2>1.0</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>2.0 1.5 0.05</size></box>
          </geometry>
          <material>
            <ambient>0.9 0.7 0.1 1</ambient>
            <diffuse>0.9 0.7 0.1 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    -->

  </world>
</sdf>
